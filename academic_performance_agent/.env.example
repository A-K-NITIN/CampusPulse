# --- OpenRouter (the LLM brain) ---
OPENROUTER_API_KEY=your_openrouter_api_key
# Chat/instruction model — pick any free chat model from openrouter.ai/models
OPENROUTER_LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# --- Embeddings (via OpenRouter /embeddings endpoint, same API key) ---
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
VECTORSTORE_DIR=./vectorstore

# --- Google Sheets (live attendance) ---
# Share the sheet with the service account's client_email, then paste the
# sheet's ID here (the long string in its URL between /d/ and /edit).
GOOGLE_SERVICE_ACCOUNT_JSON=./credentials/service_account.json
ATTENDANCE_SHEET_ID=your_google_sheet_id
ATTENDANCE_WORKSHEET_NAME=Sheet1

# --- Email (SMTP — e.g. Gmail with an App Password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com

# --- Local data paths ---
DATA_DIR=./data/csv
BASE_PAPERS_DIR=./data/documents/base_papers

# --- Deterministic thresholds ---
ATTENDANCE_THRESHOLD=75
PASS_MARK_PERCENT=50
POOR_PERFORMER_PERCENT=40
SUBJECT_AVG_THRESHOLD=55
DEADLINE_WARNING_DAYS=3
EXAM_ALERT_DAYS_BEFORE=5
